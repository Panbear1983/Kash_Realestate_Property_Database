# Licensed listing source
RENTCAST_API_KEY=

# Managed Zillow collection (review provider and source terms before enabling)
APIFY_TOKEN=
APIFY_ACTOR=maxcopell~zillow-scraper

# Optional Telegram digest
KASH_BOT_TOKEN=
KASH_CHAT_ID=

# Optional paid LLM rung for 'ask'/chat mode (see preferences.yaml -> llm.ladder).
# Leave blank to run on codex/ChatGPT alone — the anthropic rung is skipped without a key.
# Also resolved from ~/.hermes/.env if not set here.
ANTHROPIC_API_KEY=
