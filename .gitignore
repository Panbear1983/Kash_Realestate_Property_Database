# Generated pool / DB (rebuildable from CSV + sources)
pool.db
*.db

# Secrets — never commit API keys.
# Glob, not just `.env`: backups like .env.bak carry the same live keys and were previously
# stageable (scripts/set_bot_token.sh writes one on every token rotation).
.env*
!.env.example

# Local buyer data and preferences
preferences.yaml
SI_*.docx
archive/*.csv

# macOS
.DS_Store

# Update-cycle artifacts
.last_run.json
.last_run.json.corrupt
.run.lock
backups/
logs/
pool_export.csv

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
